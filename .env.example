# OmniDex / SkyDex secrets — copy this file to `.env` and paste your own keys.
# Every key has a FREE tier. A blank key just disables that one feature.
# NEVER commit your real .env — it is git-ignored on purpose.

# --- Core (get these first) ---
SKYDEX_AISSTREAM_API_KEY=        # boats on AIS       https://aisstream.io
SKYDEX_NASA_API_KEY=             # space photo of day https://api.nasa.gov
SKYDEX_OPENSKY_CLIENT_ID=        # planes fallback    https://opensky-network.org
SKYDEX_OPENSKY_CLIENT_SECRET=

# --- Strongly recommended ---
SKYDEX_RAPIDAPI_KEY=             # plane details, ham lookups, traffic  https://rapidapi.com
SKYDEX_ORS_KEY=                  # drive times        https://openrouteservice.org
SKYDEX_WINDY_KEY=                # iSpy webcams        https://api.windy.com/keys
SKYDEX_WINDY_POINT_KEY=          # forecast robots     (same Windy account)

# --- Optional extras ---
SKYDEX_WINDY_MAP_KEY=            # reserved map layers (same Windy account)
SKYDEX_AISSTREAM_KEY2=           # 2nd key: follow ships worldwide (Journeys)
SKYDEX_NYCDOT_KEY=               # NYC traffic speeds  https://api.nyc.gov/dot
SKYDEX_STORMGLASS_KEY=           # marine forecast     https://stormglass.io
SKYDEX_MAREA_TIDE_KEY=           # tide fallback       https://marea.ooo
SKYDEX_WORLDWEATHER_KEY=         # weather fallback    https://worldweatheronline.com
